
venv/
__pycache__/
*.pyc
.env
.env.*
!.env*.example

# Host-only runtime state and secrets. These are mounted by compose in
# production and must never be sent to Docker build context. Keep both root
# anchored and recursive patterns: Docker must not traverse unreadable bind
# mounts such as certbot/letsencrypt/accounts while preparing the context.
/certbot
/certbot/
/certbot/**
certbot
certbot/
certbot/**
**/certbot
**/certbot/**
letsencrypt
letsencrypt/
letsencrypt/**
**/letsencrypt
**/letsencrypt/
**/letsencrypt/**
**/letsencrypt/accounts
**/letsencrypt/accounts/**
/certs
/certs/
/certs/**
certs/
certs/**
/secrets
/secrets/
/secrets/**
secrets/
secrets/**
/keys
/keys/
/keys/**
keys/
keys/**
/uploads
/uploads/
/uploads/**
uploads/
uploads/**
/encrypted
/encrypted/
/encrypted/**
encrypted/
encrypted/**
/decrypted
/decrypted/
/decrypted/**
decrypted/
decrypted/**
/audit_logs
/audit_logs/
/audit_logs/**
audit_logs/
audit_logs/**
/backups
/backups/
/backups/**
backups/
backups/**
