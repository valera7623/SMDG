# Скопируйте в .env и подставьте значения:  cp .env.example .env
#
# Режим работы приложения
# DEV_MODE=true  — разработка (подробные логи и т.д.)
# DEV_MODE=false — продакшен-подобный режим
DEV_MODE=false

# Профиль развёртывания: russia | intl | single | saas (см. docs/DEPLOYMENT.md)
# DEPLOYMENT_TYPE=single

MAX_UPLOAD_SIZE_MB=600
JWT_ACCESS_EXPIRES_MINUTES=60

# Домен и email для Let’s Encrypt / nginx.
# DOMAIN используется docker-compose.prod.yml (например Grafana root_url).
# DOMAIN_NAME оставлен для внешних скриптов, если они ожидают это имя.
# DOMAIN=example.com
# DOMAIN_NAME=example.com
# LETSENCRYPT_EMAIL=your-email@example.com
# API_PUBLIC_URL=https://example.com

# Секретный ключ для JWT (минимум 48 символов; в Docker prod лучше через
# Docker secret `jwt_secret_key`, см. docs/src/DEPLOYMENT.md).
# JWT_SECRET_KEY=your-super-strong-secret-key-minimum-48-characters-long

# PostgreSQL / Redis (если не задаёте отдельные Docker secrets)
# В Docker prod DATABASE_URL собирает entrypoint.sh из secret `postgres_password`.
# DATABASE_URL=postgresql+asyncpg://smdg_user:password@db:5432/smdg
# REDIS_PASSWORD=change-me-long-random-redis-password
# In Docker production, set REDIS_PASSWORD only. The app URL-encodes it and
# derives REDIS_URL / SESSION_REDIS_URL / CACHE_REDIS_URL / JOB_QUEUE_REDIS_URL.

# API-ключи (через запятую, без пробелов)
#API_KEYS=test-token-1,test-token-2

# Browser/security settings. In production, keep cookies Secure and list only
# exact HTTPS origins that should send credentialed API requests.
COOKIE_SECURE=true
REQUIRE_SECURE_COOKIES=true
CORS_INCLUDE_DEV_ORIGINS=false
CORS_ORIGINS=https://example.com

# =============================================================================
# Multi-tenant (опционально)
# =============================================================================
# TENANT_DEFAULT_SUBDOMAIN=default
# TENANT_RESOLVE_LOCALHOST_AS_DEFAULT=true

# =============================================================================
# Telegram alerting (опционально)
# =============================================================================
# TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here
# TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_ARCHIVE_CHAT_ID=-1009876543210
#
# Ссылки в алертах (опционально)
# SMDG_DASHBOARD_URL=https://example.com/grafana/
# SMDG_TRACING_URL=https://example.com/jaeger/
# SMDG_LOGS_URL=https://kibana.example.com

# Webhook Alertmanager → приложение (пусто = без проверки секрета; в prod задайте)
# SMDG_ALERT_WEBHOOK_SECRET=

# =============================================================================
# S3 / MinIO
# =============================================================================
# S3_ENABLED=false — локальная ФС /app/encrypted
# S3_ENABLED=true  — объектное хранилище
S3_ENABLED=false

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

S3_BUCKET_ENCRYPTED=smdg-encrypted
S3_BUCKET_UPLOADS=smdg-uploads
S3_BUCKET_DECRYPTED=smdg-decrypted

S3_REGION=us-east-1
S3_USE_SSL=false

# =============================================================================
# DICOM viewer
# =============================================================================
DICOM_VIEWER_ENABLED=true

# =============================================================================
# OpenTelemetry / Jaeger
# =============================================================================
OTEL_ENABLED=false
OTEL_SERVICE_NAME=smdg
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_PROPAGATORS=b3multi

# Сэмплирование: в проде обычно traceidratio + 0.1; в dev можно 1.0
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

ENVIRONMENT=production
JAEGER_QUERY_URL=http://jaeger:16686

# =============================================================================
# Архивация / cold storage
# =============================================================================
ARCHIVE_ENABLED=true
COLD_STORAGE_TYPE=filesystem
# COLD_STORAGE_ENDPOINT=http://minio-cold:9000
ARCHIVE_FILE_AGE_DAYS=30
ARCHIVE_AUDIT_AGE_DAYS=365
ARCHIVE_DELETED_USER_AGE_DAYS=30
ARCHIVE_COMPRESS=true
ARCHIVE_ENCRYPT=true

# =============================================================================
# HTTP compression (ответы приложения)
# =============================================================================
COMPRESSION_ENABLED=true
COMPRESSION_MIN_SIZE_BYTES=500
COMPRESSION_GZIP_LEVEL=6
COMPRESSION_BROTLI_QUALITY=6
COMPRESSION_BROTLI_ENABLED=true
COMPRESSION_GZIP_ENABLED=true

# Шаблоны nginx / инфраструктура (опционально)
NGINX_GZIP_ENABLED=true
NGINX_GZIP_LEVEL=6
NGINX_BROTLI_ENABLED=true

# =============================================================================
# Нагрузочное тестирование (только pre-prod; в проде оставьте false)
# =============================================================================
# LOAD_TEST_MODE=false
# RATE_LIMIT_DEFAULT=100/minute
# RATE_LIMIT_LOGIN=10/minute;5/10seconds

# =============================================================================
# Прочее (по необходимости)
# =============================================================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_USER=your-email@example.com
# EMAIL_PASSWORD=your-app-password

S3_USE_SSL=false
S3_USE_SSL=false
S3_USE_SSL=false