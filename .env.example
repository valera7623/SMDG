# Режим работы приложения
# DEV_MODE=true  - режим разработки (включен hot-reload, подробные логи)
# DEV_MODE=false - режим продакшена
DEV_MODE=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=60
MAX_UPLOAD_SIZE_MB=50
DOMAIN_NAME=fileguardian.com.ru         
LETSENCRYPT_EMAIL=valera7623@gmail.com

# Секретный ключ для JWT токенов
# Должен быть минимум 32 символа, сложный для безопасности
#JWT_SECRET_KEY=your-super-strong-secret-key-minimum-32-characters-long

# URL для подключения к базе данных PostgreSQL
# Формат: postgresql+asyncpg://username:password@host:port/database
#DATABASE_URL=postgresql+asyncpg://smdg_user:password@db:5432/smdg

# URL для подключения к Redis
# Формат: redis://host:port/database_number
#REDIS_URL=redis://redis:6379/0

# Список API ключей для доступа к API
# Разделяются запятыми без пробелов
#API_KEYS=test-token-1,test-token-2,admin-token-secret

# Опционально - можно добавить следующие переменные при необходимости:

# Email настройки (если используется)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# Настройки CORS (если есть фронтенд)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Другие секретные ключи (если нужны)
# SECRET_KEY_2=another-secret-value
# CRYPTO_KEY=encryption-key-for-sensitive-data