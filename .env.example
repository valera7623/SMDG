# Режим работы приложения
# DEV_MODE=true  - режим разработки (включен hot-reload, подробные логи)
# DEV_MODE=false - режим продакшена
DEV_MODE=true

# Профиль развёртывания: russia | intl | single | saas (см. docs/DEPLOYMENT.md)
# DEPLOYMENT_TYPE=single
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=60
MAX_UPLOAD_SIZE_MB=600
DOMAIN_NAME=fileguardian.com.ru         
LETSENCRYPT_EMAIL=valera7623@gmail.com

# Секретный ключ для JWT токенов
# Должен быть минимум 32 символа, сложный для безопасности
#JWT_SECRET_KEY=your-super-strong-secret-key-minimum-32-characters-long

# URL для подключения к базе данных PostgreSQL
# Формат: postgresql+asyncpg://username:password@host:port/database
#DATABASE_URL=postgresql+asyncpg://smdg_user:password@db:5432/smdg

# URL для подключения к Redis
# Формат: redis://host:port/database_number
#REDIS_URL=redis://redis:6379/0

# Список API ключей для доступа к API
# Разделяются запятыми без пробелов
#API_KEYS=test-token-1,test-token-2,admin-token-secret

# Опционально - можно добавить следующие переменные при необходимости:

# Email настройки (если используется)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# Настройки CORS (если есть фронтенд)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Другие секретные ключи (если нужны)
# SECRET_KEY_2=another-secret-value
# CRYPTO_KEY=encryption-key-for-sensitive-data

# =============================================================================
# Multi-tenant (опционально)
# =============================================================================
# Резервный поддомен tenant, если в Host нет первого лейбла (localhost / 127.0.0.1 и т.п.)
# TENANT_DEFAULT_SUBDOMAIN=default

# Для локальной разработки: сопоставлять localhost → tenant с поддоменом TENANT_DEFAULT_SUBDOMAIN
# TENANT_RESOLVE_LOCALHOST_AS_DEFAULT=true

# =============================================================================
# S3 / MinIO Configuration (опционально)
# =============================================================================
# Включить S3 режим хранения файлов (вместо локальной ФС)
# S3_ENABLED=true   - использовать S3/MinIO для хранения зашифрованных файлов
# S3_ENABLED=false  - использовать локальную директорию /app/encrypted (по умолчанию)
S3_ENABLED=false

# URL endpoint S3 хранилища
# Для MinIO: http://minio:9000
# Для Yandex Object Storage: https://storage.yandexcloud.net
# Для Selectel: https://s3.selcdn.ru
# Для AWS S3: https://s3.amazonaws.com
S3_ENDPOINT_URL=http://minio:9000

# Ключи доступа к S3 (в production использовать Docker secrets!)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

# Имена бакетов для разных типов данных
S3_BUCKET_ENCRYPTED=smdg-encrypted
S3_BUCKET_UPLOADS=smdg-uploads
S3_BUCKET_DECRYPTED=smdg-decrypted

# Регион S3 (для AWS S3 указать свой, для MinIO обычно us-east-1)
S3_REGION=us-east-1

# Использовать HTTPS для подключения к S3
# true  - для внешних S3 провайдеров (Yandex, AWS, Selectel)
# false - для локального MinIO в Docker
S3_USE_SSL=false

# =============================================================================
# Distributed tracing (OpenTelemetry)
# =============================================================================
# Поднимать Jaeger + OpenTelemetry Collector:
#   docker compose -f docker-compose.observability.yml up -d
#
# UI Jaeger:     http://localhost:16686
# API поиска:    /api/tracing/search?service=smdg  (admin-only)
#
# OTEL_ENABLED: мастер-выключатель. При false приложение работает вообще
# без OpenTelemetry (никаких попыток подключиться к коллектору).
OTEL_ENABLED=false

# Имя сервиса, под которым трассы видны в Jaeger.
OTEL_SERVICE_NAME=smdg

# gRPC endpoint OTLP-коллектора. Внутри docker-сети: otel-collector:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Формат пропагации trace-контекста между сервисами. B3 совместим с nginx
# upstream, который уже пробрасывает ``x-b3-*`` заголовки.
OTEL_PROPAGATORS=b3multi

# Сэмплирование: trace только 10% запросов, чтобы не уронить производительность
# и не переполнить Jaeger. В dev можно поставить 1.0 (100%).
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# Окружение, попадает в атрибут ``deployment.environment``.
ENVIRONMENT=production

# URL Jaeger Query API для admin-эндпоинта /api/tracing/* (читает трассы)
# и healthcheck /health/checks.
#
# Dev (docker-compose.observability.yml, QUERY_BASE_PATH не задан):
#     JAEGER_QUERY_URL=http://jaeger:16686
#
# Prod (docker-compose.observability.prod.yml, Jaeger UI под /jaeger/
# через nginx + Basic Auth, QUERY_BASE_PATH=/jaeger):
#     JAEGER_QUERY_URL=http://jaeger:16686/jaeger
JAEGER_QUERY_URL=http://jaeger:16686

# =============================================================================
# Alerting / Telegram (опционально)
# =============================================================================
# Telegram bot token и основной chat_id для alert-уведомлений.
# TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here
# TELEGRAM_CHAT_ID=-1001234567890
#
# Отдельный чат для archive-алертов (Alertmanager route component=archive).
# Если не задан, archive-алерты уйдут в TELEGRAM_CHAT_ID.
# TELEGRAM_ARCHIVE_CHAT_ID=-1009876543210