# ============================================================
# SMDG Demo — Environment Configuration
# ============================================================
# Usage:
#   cp .env.demo.example .env
#   # Edit DOMAIN, JWT_SECRET_KEY, LETSENCRYPT_EMAIL
#   docker compose -f docker-compose.demo.yml up -d --build
#
# Target: US audience (Upwork portfolio), 2GB RAM server
# Profile: demo (HIPAA/GDPR-oriented, local storage, no MinIO)
# ============================================================

# ─── Demo mode flags ──────────────────────────────────────
DEMO_MODE=true
DEPLOYMENT_TYPE=demo
DEV_MODE=true

# How often demo data resets (hours). Default: 24.
DEMO_RESET_INTERVAL_HOURS=24

# Registration rate limit (per IP, stored in Redis RATE_LIMIT_STORAGE)
RATE_LIMIT_REGISTER=3/hour

# ─── Your domain ──────────────────────────────────────────
# Replace with the actual domain pointing to this server.
DOMAIN=demo.yourdomain.com
LETSENCRYPT_EMAIL=your-email@example.com

# Public URL used in shared-link emails and CORS header.
# Set to https://<DOMAIN> after DNS is configured.
API_PUBLIC_URL=https://demo.yourdomain.com

# ─── Secrets (required — no defaults in docker-compose.demo.yml) ─
# Generate a strong JWT secret (min 48 chars):
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_64_HEX_CHARS_SECRET_KEY_MINIMUM_48_CHARS

# Demo admin password (shown on the public login page — use a unique demo-only value).
ADMIN_PASSWORD=REPLACE_WITH_STRONG_DEMO_ADMIN_PASSWORD

# PostgreSQL password — internal only; must match POSTGRES_PASSWORD in compose / db service.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_USER=smdg_user
POSTGRES_DB=smdg

# ─── Security ─────────────────────────────────────────────
COOKIE_SECURE=true
REQUIRE_SECURE_COOKIES=true
CORS_INCLUDE_DEV_ORIGINS=false
# Add your domain to allow credentialed API requests from the browser.
CORS_ORIGINS=https://demo.yourdomain.com

# ─── Upload limits ────────────────────────────────────────
# Capped at 10MB in demo mode to keep disk usage minimal.
MAX_UPLOAD_SIZE_MB=10

# ─── Performance tuning for 2GB RAM ──────────────────────
WEB_CONCURRENCY=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
MAX_CONCURRENT_REQUESTS=50

# ─── Disabled heavy services ──────────────────────────────
S3_ENABLED=false
OTEL_ENABLED=false
ARCHIVE_ENABLED=false
CDN_ENABLED=false
READ_REPLICAS_ENABLED=false

# ─── TLS renewal (see scripts/renew_demo_tls.sh) ───────────
# After first certonly: ./scripts/link_le_certs.sh
# Daily cron: ./scripts/install_demo_cert_cron.sh
# Manual renew test: ./scripts/renew_demo_tls.sh
# Staging LE (dry-run against LE staging): LETSENCRYPT_STAGING=true ./scripts/renew_demo_tls.sh

# ─── Optional: Telegram alerts ───────────────────────────
# Uncomment to receive uptime/error alerts in Telegram.
# TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here
# TELEGRAM_CHAT_ID=-1001234567890

# ─── Billing (Stripe + YooKassa, like ReportAgent) ───────
# Disable limits and checkout for testing:
BILLING_ENABLED=false

# Upload limits per plan (when BILLING_ENABLED=true)
FREEMIUM_UPLOADS_LIMIT=10
PREMIUM_UPLOADS_LIMIT=500
ENTERPRISE_UPLOADS_LIMIT=5000

# Stripe (international)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_MONTHLY=price_...
# STRIPE_PRICE_ID_YEARLY=price_...
# STRIPE_PRICE_ID_PAYG=price_...
# STRIPE_SUCCESS_URL=https://fileguardian.info/payment/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://fileguardian.info/payment/cancel

# YooKassa (Russia)
# YOOKASSA_SHOP_ID=...
# YOOKASSA_SECRET_KEY=...
# YOOKASSA_RETURN_URL_SUCCESS=https://fileguardian.info/payment/success
# YOOKASSA_RETURN_URL_CANCEL=https://fileguardian.info/payment/cancel
# YOOKASSA_AUTO_CAPTURE_ON_WAITING=true
# PRICE_PREMIUM_MONTHLY=1990
# PRICE_PREMIUM_YEARLY=19900
# PRICE_ENTERPRISE=9990
