# Пример окружения: Россия (ФЗ-152) — локальное хранилище, обязательная 2FA в политике.
DEPLOYMENT_TYPE=russia
DEV_MODE=false
S3_ENABLED=false
# В Docker prod задавайте JWT через secret `jwt_secret_key`.
# JWT_SECRET_KEY=your-super-strong-secret-key-minimum-48-characters-long
REDIS_PASSWORD=change-me-long-random-redis-password
MANDATORY_POLICY=152
