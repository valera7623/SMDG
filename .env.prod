# =============================================================================
# Прод-окружение для: docker compose --env-file .env.prod
#   -f docker-compose.yml -f docker-compose.prod.yml
#
# Важно: не коммитьте файл с реальными паролями/ключами.
# На VPS: chmod 600 .env.prod
# =============================================================================

# --- Образ (Docker Hub) ---
DOCKER_USERNAME=valera7623
IMAGE_TAG=latest

# Опционально: git SHA в /metrics (подставьте при CI/CD)
# GIT_SHA=abc1234

# --- Публичный домен (Grafana: https://${DOMAIN}/grafana/) ---
DOMAIN=fileguardian.com.ru

# База для ссылок в webhooks/интеграциях. Должен совпадать с HTTPS на VPS.
API_PUBLIC_URL=https://fileguardian.com.ru

# Режим (подставляется в smdg, см. docker-compose)
ENVIRONMENT=production

# --- Redis (тот же пароль, что --requirepass у redis; и подстановка в REDIS_URL в prod) ---
# Сгенерировать, например: openssl rand -base64 32
REDIS_PASSWORD=94zgt8LIe1p9OLAPU1ooQekZu45ijP/oRP4YvGNp8zQ=

# --- S3: Yandex Object Storage ---
# Создайте 3 бакета в консоли Yandex Cloud и сервисный аккаунт с ключом доступа.
# Регион каталога обычно ru-central1 (для API CreateBucket/constraint).
S3_ENABLED=false
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_USE_SSL=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_ENCRYPTED=fileguardian-prod-encrypted
S3_BUCKET_UPLOADS=fileguardian-prod-uploads
S3_BUCKET_DECRYPTED=fileguardian-prod-decrypted

# --- Тест без S3 (одна нода, файлы в Docker-томах) — закомментируйте блок S3 выше и раскомментируйте:
# S3_ENABLED=false
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Пример: docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d
