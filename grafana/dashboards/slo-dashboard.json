{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SMDG Service Level Objectives — availability, latency, compliance, error budget.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "smdg-slo",
  "title": "SMDG SLO Dashboard",
  "tags": ["smdg", "slo", "sli"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "current": {"selected": false, "text": "Prometheus", "value": "prometheus"},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "links": [
    {
      "icon": "external link",
      "tags": [],
      "targetBlank": true,
      "title": "Alertmanager",
      "type": "link",
      "url": "http://alertmanager:9093"
    },
    {
      "icon": "external link",
      "tags": [],
      "targetBlank": true,
      "title": "Runbooks",
      "type": "link",
      "url": "https://wiki.smdg/runbooks"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "panels": [],
      "title": "Availability (SLI)",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Overall Service Availability (24h)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 99.0},
              {"color": "green", "value": 99.9}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{status=~\"2..\"}[5m])) / sum(rate(http_requests_total[5m]))) * 100",
          "legendFormat": "Availability",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Top-10 problematic endpoints (5xx share)",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 1},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "custom": {"displayMode": "color-background"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 0.001},
              {"color": "red", "value": 0.01}
            ]
          }
        }
      },
      "options": {"showHeader": true, "sortBy": [{"desc": true, "displayName": "Value"}]},
      "targets": [
        {
          "expr": "topk(10, sum by (handler) (rate(http_requests_total{status=~\"5..\"}[5m])) / sum by (handler) (rate(http_requests_total[5m])))",
          "legendFormat": "{{ handler }}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "id": 101,
      "panels": [],
      "title": "Latency (SLI)",
      "type": "row"
    },
    {
      "id": 3,
      "title": "Latency quantiles (p50 / p90 / p99)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 10},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}},
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "right"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 19},
      "id": 102,
      "panels": [],
      "title": "SLO Compliance & Error Budget",
      "type": "row"
    },
    {
      "id": 4,
      "title": "SLO Compliance (all SLOs)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 20},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 95},
              {"color": "green", "value": 99}
            ]
          }
        }
      },
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "right"}},
      "targets": [
        {
          "expr": "smdg_slo_compliance",
          "legendFormat": "{{slo_name}} (target {{target}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Error Budget remaining (api_availability)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 20},
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 2}},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom"}},
      "targets": [
        {
          "expr": "smdg_error_budget_remaining_seconds{slo_name=\"api_availability\"}",
          "legendFormat": "remaining",
          "refId": "A"
        },
        {
          "expr": "smdg_error_budget_spent_seconds{slo_name=\"api_availability\"}",
          "legendFormat": "spent",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Allowed monthly downtime (error budget, 99.9% SLO)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 29},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "(1 - (sum(rate(http_requests_total{status=~\"2..\"}[30d])) / sum(rate(http_requests_total[30d])))) * 30 * 24 * 3600",
          "legendFormat": "allowed 30d downtime (s)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "SLO last update (seconds ago)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 29},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 120},
              {"color": "red", "value": 300}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "time() - smdg_slo_last_update",
          "legendFormat": "lag",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34},
      "id": 103,
      "panels": [],
      "title": "Dependencies",
      "type": "row"
    },
    {
      "id": 8,
      "title": "Dependencies availability (%)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 35},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2
        }
      },
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "right"}},
      "targets": [
        {"expr": "smdg_db_availability", "legendFormat": "PostgreSQL", "refId": "A"},
        {"expr": "smdg_redis_availability", "legendFormat": "Redis", "refId": "B"},
        {"expr": "smdg_storage_availability", "legendFormat": "Storage", "refId": "C"}
      ]
    }
  ]
}
