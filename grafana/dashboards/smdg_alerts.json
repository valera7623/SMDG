      "pluginVersion": "10.4.5",
      "targets": [
        {"expr": "sum(rate(auth_failures_total[5m])) by (reason)", "legendFormat": "auth/{{reason}}", "refId": "A"},
        {"expr": "rate(auth_2fa_failures_total[5m])", "legendFormat": "2fa", "refId": "B"}
      ],
      "title": "Auth failures",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}
