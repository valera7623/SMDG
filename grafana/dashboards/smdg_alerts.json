      "targets": [{"expr": "increase(cross_tenant_access_total[24h])", "refId": "A"}],
      "title": "Cross-tenant attempts (24h)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "id": 103,
      "panels": [],
      "title": "Queues & capacity",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}},
