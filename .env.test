DEV_MODE=true
ENVIRONMENT=test
DOMAIN_NAME=fileguardian.com.ru         
LETSENCRYPT_EMAIL=valera7623@gmail.com
MAX_UPLOAD_SIZE_MB=600
# Test-only credentials (local/CI); never use in production.
ADMIN_PASSWORD=test-local-admin-only
JWT_ALGORITHM=HS256
jwt_access_expires_minutes=30
JWT_SECRET_KEY=test-jwt-secret-key-minimum-32-characters!!

# Local pytest uses localhost; last DATABASE_URL wins in python-dotenv.
DATABASE_URL=postgresql+asyncpg://smdg_user:password@localhost:5432/smdg_test
DATABASE_URL_SYNC=postgresql://smdg_user:password@localhost:5432/smdg_test

REDIS_URL=redis://localhost:6379/1

UPLOAD_DIR=/tmp/smdg_test/uploads
ENCRYPTED_DIR=/tmp/smdg_test/encrypted
DECRYPTED_DIR=/tmp/smdg_test/decrypted
PRIVATE_KEY_PATH=/tmp/smdg_test/keys/age.key
PUBLIC_KEY_PATH=/tmp/smdg_test/keys/age.pub

CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# S3/MinIO отключён для тестов (используется локальное хранилище)
S3_ENABLED=false
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
